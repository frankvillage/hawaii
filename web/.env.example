NEXT_PUBLIC_SITE_URL=https://www.hawaiipescara.it
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2026-04-07

# WordPress fusion bridge: WP origin for fallback rewrites (strangler pattern).
# Point the public domain at this Next app and move WordPress to a subdomain,
# then set e.g. WP_ORIGIN_URL=https://wp.hawaiipescara.it
# Unset = bridge disabled.
WP_ORIGIN_URL=
