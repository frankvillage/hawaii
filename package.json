  "main": "index.js",
  "scripts": {
    "start:prototype": "python3 -m http.server 4173 --bind 127.0.0.1 -d prototype",
    "test:prototype": "node tests/prototype-smoke.js",
    "test:prototype:mobile": "node tests/prototype-mobile-playwright.js",
    "test:web:booking": "node --no-warnings --experimental-strip-types tests/booking-config.test.mjs",
    "test:web:booking:browser": "node tests/run-web-booking.js",
    "test:web:journey": "node --no-warnings --experimental-strip-types --test tests/journey-playback.test.mjs tests/journey-clip-plan.test.mjs tests/journey-clip-player.test.mjs tests/journey-segment-machine.test.mjs tests/journey-segment-controller.test.mjs",
    "test:web:static": "node tests/web-static.js",
    "test:web:smoke": "node tests/web-smoke.js",
    "build:presentation": "node presentation/src/hawaii_pescara_2026_presentation.js",
    "render:presentation": "python3 presentation/render_slides.py presentation/output/hawaii-pescara-2026-proposta.pptx --output_dir presentation/rendered",
    "test:presentation": "python3 presentation/slides_test.py presentation/output/hawaii-pescara-2026-proposta.pptx",
    "fonts:presentation": "python3 presentation/detect_font.py presentation/output/hawaii-pescara-2026-proposta.pptx --json"
  },
